---
import { closing, profiles, contact, person, flag } from '../data/site';
const rows = [
  { label: 'Email', value: contact.email.address, href: `mailto:${contact.email.address}`, review: contact.email.review },
  ...profiles.map((p) => ({ label: p.label, value: p.handle, href: p.url, review: 'review' in p ? p.review : undefined })),
];
---
<section class="closing scene scene--dark" id="contact" data-scene="dark" aria-labelledby="contact-h">
  <div class="closing__inner wrap">
    <div class="closing__head">
      <h2 id="contact-h" class="closing__statement" {...flag(closing)}>{closing.statement}</h2>
      <p class="closing__lead">{closing.lead}</p>
    </div>
    <div class="closing__route">
      <svg class="closing__spine" aria-hidden="true" focusable="false" preserveAspectRatio="none" viewBox="0 0 2 100"><line class="spine-base" x1="1" x2="1" y1="0" y2="100" /><line class="spine-run" x1="1" x2="1" y1="0" y2="100" pathLength="100" /></svg>
      <ul class="closing__links">
        {rows.map((r) => (
          <li {...flag({ review: r.review })}>
            <a href={r.href} rel="noopener"><span class="closing__node" aria-hidden="true"></span><span class="closing__label">{r.label}</span><span class="closing__value">{r.value}</span></a>
          </li>
        ))}
      </ul>
    </div>
    <p class="closing__colophon small"><span>{person.name}</span><a href="#top">Back to top</a></p>
  </div>
</section>
