---
import { writing, flag } from '../data/site';
---
<section class="writing scene scene--sand" id="writing" data-scene="paper" aria-labelledby="writing-h">
  <div class="wrap">
    <div class="cols">
      <div class="writing__intro">
        <h2 class="display" id="writing-h">Writing</h2>
        <p class="lede" {...flag(writing)}>{writing.intro}</p>
      </div>
      <ul class="articles">
        {writing.articles.map((a) => (
          <li {...flag(a)}>
            <a class="article" href={a.url} rel="noopener">
              <span class="article__meta"><span>{a.topic}</span><span>{a.venue}, {a.date}</span></span>
              <span class="article__title">{a.title}</span>
              <span class="article__cta">Read on {a.venue}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
