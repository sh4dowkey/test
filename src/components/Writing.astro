---
import { writing } from '../data/site';
---
<section class="scene scene--paper writing" id="writing" data-scene="paper" aria-labelledby="writing-h">
  <div class="wrap writing__grid">
    <header data-reveal-group>
      <h2 class="h2" id="writing-h" data-reveal-item>{writing.heading}</h2>
      <p class="sec-head__lede" data-reveal-item>{writing.lede}</p>
    </header>
    <ul class="posts" data-reveal-group>
      {writing.articles.map((a) => (
        <li data-reveal-item>
          <a class="post" href={a.url} rel="noopener">
            <span class="post__title">{a.title}</span>
            <span class="post__meta"><time>{a.date}</time> &middot; {a.topic} &middot; Medium</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
