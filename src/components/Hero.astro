---
import { person, index, resume } from '../data/site';
---
<section class="hero scene scene--ink" id="top" data-scene="dark" aria-label="Introduction">
  <div class="hero__glow" aria-hidden="true"><i class="g1"></i><i class="g2"></i></div>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title">
        {person.heroLines.map((l, i) => (
          <span class="hero__line" data-intro><span class="hero__line-in" data-i={i}>{l.text}</span></span>
        ))}
      </h1>
      <p class="hero__intro" data-intro>{person.intro}</p>
      <p class="hero__actions" data-intro>
        <a class="btn btn--light" href="#work">See the work</a>
        <a class="textlink" href={resume.pdf.href} download={resume.pdf.filename}>R&eacute;sum&eacute; (PDF)</a>
      </p>
    </div>
    <nav class="hero__index" aria-label="Selected work" data-intro>
      <p class="hero__index-label">In this portfolio</p>
      <div class="index-wrap">
      <ol class="index">
        {index.map((p) => (
          <li class="index__row" data-id={p.id}>
            <a class="index__link" href={p.href}>
              <span class="index__n">{p.n}</span>
              <span class="index__body"><span class="index__name">{p.name}</span><span class="index__meta">{p.meta}</span></span>
              <span class="index__kind">{p.kind}</span>
            </a>
          </li>
        ))}
      </ol>
      <span class="index__trace" aria-hidden="true"><i class="index__trace-fill"></i></span>
      </div>
    </nav>
  </div>
</section>
