---
const word = 'Welcome'.split('');
const sub = 'Take a look around.';
---
<section class="hero" id="top" aria-label="Welcome">
  <div class="hero__pin">
    <!-- light copy sits below the paper layer, so the paper covers it as it grows -->
    <div class="hero__copy">
      <h1 class="hero__word" aria-label="Welcome">{word.map((c) => <span class="ch" aria-hidden="true"><span>{c}</span></span>)}</h1>
      <p class="hero__sub"><span>{sub}</span></p>
    </div>
    <div class="hero__paper" aria-hidden="true">
      <div class="hero__copy hero__copy--ink">
        <p class="hero__word">{word.map((c) => <span class="ch"><span>{c}</span></span>)}</p>
        <p class="hero__sub"><span>{sub}</span></p>
      </div>
    </div>
    <canvas class="hero__canvas" aria-hidden="true"></canvas>
    <a class="hero__cue" href="#work"><span>Scroll</span><i aria-hidden="true"></i></a>
  </div>
</section>
