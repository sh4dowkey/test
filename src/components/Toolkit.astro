---
import { toolkit, index } from '../data/site';
const targets = [...toolkit.evidenceTargets, ...index];
const name = (id: string) => targets.find((p) => p.id === id)?.name ?? id;
---
<section class="scene scene--ink kit" id="toolkit" data-scene="dark" aria-labelledby="kit-h">
  <div class="wrap">
    <header class="sec-head sec-head--d" data-reveal-group>
      <h2 class="h2" id="kit-h" data-reveal-item>{toolkit.heading}</h2>
      <p class="sec-head__lede" data-reveal-item>{toolkit.lede}</p>
    </header>
    <div class="kit__wrap" data-kit>
      <svg class="kit__trace" aria-hidden="true" focusable="false"></svg>
      <div class="kit__groups" data-reveal-group>
        {toolkit.groups.map((g) => (
          <section class="kit__group" data-reveal-item aria-labelledby={`kit-${g.id}`}>
            <h3 class="kit__title" id={`kit-${g.id}`}>{g.title}</h3>
            <ul class="kit__items">
              {g.items.map((t) => (
                <li>
                  <button type="button" class="tool" data-projects={t.evidence.join(' ')} aria-pressed="false">
                    <span class="tool__name">{t.name}</span>
                    <span class="tool__note">{t.note}</span>
                    <span class="sr-only">Appears in {t.evidence.map(name).join(', ')}.</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <nav class="kit__projects" aria-label="Where these tools appear" data-reveal-group>
        <p class="kit__label" data-reveal-item>Where it appears</p>
        <ul>
          {targets.map((p) => (
            <li data-reveal-item><a class="chip" href={p.href} data-id={p.id}><span class="chip__n">{p.n}</span>{p.name}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</section>
