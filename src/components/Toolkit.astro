---
import { toolkit, flag } from '../data/site';
---
<section class="toolkit scene scene--paper" id="toolkit" data-scene="paper" aria-labelledby="toolkit-h">
  <div class="wrap">
    <div class="cols">
      <div class="toolkit__intro">
        <h2 class="display" id="toolkit-h">{toolkit.heading}</h2>
        <p class="lede">{toolkit.lede}</p>
        <p class="toolkit__legend small" aria-hidden="true"><span class="mark mark--on"></span> Public work on this page <span class="mark mark--off"></span> R&eacute;sum&eacute; only</p>
      </div>
      <div class="toolkit__groups">
        <svg class="toolkit__spine" aria-hidden="true" focusable="false" preserveAspectRatio="none" viewBox="0 0 2 100"><line class="spine-base" x1="1" x2="1" y1="0" y2="100" /><line class="spine-run" x1="1" x2="1" y1="0" y2="100" pathLength="100" /></svg>
        {toolkit.groups.map((g) => (
          <div class="tgroup">
            <h3 class="tgroup__title"><span class="tgroup__node" aria-hidden="true"></span>{g.title}</h3>
            <ul class="tgroup__items">
              {g.items.map((it) => (
                <li class={`tool ${it.evidence ? 'tool--on' : 'tool--off'}`} {...flag(it)}>
                  {it.evidence
                    ? <a href={it.evidence.href}><span class="mark mark--on" aria-hidden="true"></span><span class="tool__name">{it.name}</span><span class="tool__note">{it.evidence.label}</span></a>
                    : <span class="tool__static"><span class="mark mark--off" aria-hidden="true"></span><span class="tool__name">{it.name}</span><span class="tool__note">R&eacute;sum&eacute;</span></span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
