---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Lab from '../components/Lab.astro';
import Pwndbg from '../components/Pwndbg.astro';
import Toolkit from '../components/Toolkit.astro';
import Writing from '../components/Writing.astro';
import Resume from '../components/Resume.astro';
import Contact from '../components/Contact.astro';
import { person, work, crawlx, cliCrawler } from '../data/site';
---
<Base title={`${person.name}: Python and Go security tools, labs and open source`} description={person.description}>
  <Nav />
  <main id="main">
    <Hero />

    <!-- Light scene that rises over the hero. First project is visible straight away; no spacer. -->
    <div class="curtain" id="work">
      <section class="scene scene--paper work" data-scene="paper" aria-labelledby="work-h">
        <div class="wrap">
          <header class="sec-head" data-reveal-group>
            <h2 class="h2" id="work-h" data-reveal-item>{work.heading}</h2>
            <p class="sec-head__lede" data-reveal-item>{work.lede}</p>
          </header>

          <article class="project project--crawlx" id={crawlx.id} aria-labelledby="crawlx-h">
            <div class="project__text" data-reveal-group>
              <p class="kicker" data-reveal-item>01 &middot; {crawlx.kicker}</p>
              <h3 class="h3" id="crawlx-h" data-reveal-item>{crawlx.name}</h3>
              <p class="lede" data-reveal-item>{crawlx.lede}</p>
              <dl class="facts" data-reveal-item>
                {crawlx.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
              </dl>
              <p class="project__links" data-reveal-item><a class="btn btn--dark" href={crawlx.repoUrl} rel="noopener">View source on GitHub</a></p>
            </div>
            <div class="crawlx__frame" data-frame>
              <figure class="shot shot--wide" data-parallax="10">
                <a href={crawlx.shots[0].src} target="_blank" rel="noopener" aria-label="Open the full-size screenshot in a new tab"><img src={crawlx.shots[0].src} width={crawlx.shots[0].w} height={crawlx.shots[0].h} loading="lazy" decoding="async" alt={crawlx.shots[0].alt} /></a>
                <figcaption><code>{crawlx.shots[0].caption}</code></figcaption>
              </figure>
              <div class="crawlx__row">
                <figure class="shot" data-parallax="-8">
                  <a href={crawlx.shots[1].src} target="_blank" rel="noopener" aria-label="Open the full-size screenshot in a new tab"><img src={crawlx.shots[1].src} width={crawlx.shots[1].w} height={crawlx.shots[1].h} loading="lazy" decoding="async" alt={crawlx.shots[1].alt} /></a>
                  <figcaption><code>{crawlx.shots[1].caption}</code></figcaption>
                </figure>
                <figure class="pool" aria-label="Illustration of CrawlX's worker pool: a task queue feeds ten workers, which send results to the report.">
                  <div class="pool__stage" aria-hidden="true">
                    <div class="pool__col pool__queue"><span class="pool__tok"></span><span class="pool__tok"></span><span class="pool__tok"></span></div>
                    <div class="pool__workers">{Array.from({ length: crawlx.pipeline.workers }).map(() => <i class="pool__w"></i>)}</div>
                    <div class="pool__col pool__out"><i></i><i></i><i></i></div>
                  </div>
                  <ul class="pool__legend">{crawlx.pipeline.steps.map((s) => <li>{s}</li>)}</ul>
                  <figcaption>Illustration: <code>NumWorkers = 10</code> in <code>crawler.go</code>.</figcaption>
                </figure>
              </div>
            </div>
          </article>

          <article class="project project--cli" id={cliCrawler.id} aria-labelledby="cli-h">
            <div class="cli__panel" data-frame>
              <p class="cli__usage" aria-label="Usage">
                <span class="t1">{cliCrawler.usage[0]}</span> <span>{cliCrawler.usage[1]}</span> <span class="t2">{cliCrawler.usage[2]}</span> <span class="t2">{cliCrawler.usage[3]}</span>
              </p>
              <dl class="cli__opts" data-reveal-group>
                {cliCrawler.options.map(([k, d]) => <div data-reveal-item><dt>{k}</dt><dd>{d}</dd></div>)}
              </dl>
              <p class="cli__note">{cliCrawler.note}</p>
            </div>
            <div class="project__text" data-reveal-group>
              <p class="kicker" data-reveal-item>02 &middot; {cliCrawler.kicker}</p>
              <h3 class="h3" id="cli-h" data-reveal-item>{cliCrawler.name}</h3>
              <p class="lede" data-reveal-item>{cliCrawler.lede}</p>
              <p class="project__links" data-reveal-item><a class="btn btn--dark" href={cliCrawler.repoUrl} rel="noopener">View source on GitHub</a></p>
            </div>
          </article>
        </div>
      </section>

      <Lab />
      <Pwndbg />
      <Toolkit />
      <Writing />
      <Resume />
      <Contact />
    </div>
  </main>
</Base>
